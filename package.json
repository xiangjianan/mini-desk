{
  "name": "mini-desk",
  "version": "1.0.138",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && npm run typecheck:worker && vite build",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "preview": "npm run build && vite preview",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name=todolist",
    "deploy:worker": "npx wrangler deploy --config worker/wrangler.toml",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vicons/ionicons5": "latest",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "latest",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
