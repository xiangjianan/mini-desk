{
  "name": "mini-desk",
  "version": "1.0.159",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "npm run build && vite preview",
    "preview:lan": "npm run build && MINI_DESK_LAN=1 vite preview --host",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name=todolist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vicons/ionicons5": "latest",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "latest",
    "qrcode": "^1.5.4",
    "vue": "latest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "latest",
    "@vue/test-utils": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vue-tsc": "latest"
  }
}
